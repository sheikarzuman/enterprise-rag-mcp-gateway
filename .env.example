POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=enterprise_db
# Used when running the app outside Docker (the compose stack builds its own URL)
DATABASE_URL=postgresql://app_user:change_me_db_password@localhost:5433/enterprise_db
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_long_random_secret
# Leave as mock-key for offline responses, or set a real Anthropic key
ANTHROPIC_API_KEY=mock-key
